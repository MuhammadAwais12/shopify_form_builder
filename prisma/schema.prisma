// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("db_url")
  
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Form {  
  id          String       @id @default(cuid())// form id
  shop        String                           // shop domain, e.g. "my-shop.myshopify.com"
  name        String                           // form name, e.g. "Contact Us"
  slug        String                          // public handle, e.g. "contact-us"
  status      String       @default("draft")      // "draft" | "published" (validate in code)
  submitButtonText String @default("Submit")
  successMessage   String @default("Thanks! Your response was received.") @db.VarChar(500)
  notificationEmail String? @db.VarChar(254)       // optional: where new submissions are emailed
  fields      Field[]                         // form fields
  submissions Submission[]                    // form submissions
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([shop, slug])
  @@index([shop, status])
}

model Field {
  id         String    @id @default(cuid())
  formId     String
  label      String
  fieldType  String                            // "text" | "email" | "number" | "phone" | "textarea" | "select" | "radio" | "checkbox" | "date" (validate in code)
  required   Boolean   @default(false)
  options    Json?                             // select/radio only: ["Option 1", "Option 2"]
  position   Int       @default(0)
  placeholder String?
  archivedAt DateTime?                         // set instead of deleting; null = active
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, archivedAt])
}

model Submission {
  id        String   @id @default(cuid())
  formId    String
  data      Json                               // { "<fieldId>": value, ... }
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}